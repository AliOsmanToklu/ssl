# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# Required in production: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs session cookies and e-mail links (verification, password reset).
KALKAN_SECRET_KEY=

# SQLite by default; PostgreSQL in production:
# KALKAN_DATABASE_URL=postgresql+psycopg://kalkan:password@localhost:5432/kalkan
KALKAN_DATABASE_URL=sqlite:///./kalkan.db
# Apply migrations when the web app starts. Set to false when `kalkan migrate`
# runs as a separate deployment step (docker-compose.yml does this).
KALKAN_AUTO_MIGRATE=true

# Public address of the app: used in e-mail links.
KALKAN_PUBLIC_URL=http://127.0.0.1:8000
# Set to true behind HTTPS (Secure cookies + HSTS).
KALKAN_HTTPS_ONLY=false

# Run scans inside the web process (single instance). Set to false and run
# `kalkan worker` separately when you deploy more than one process.
KALKAN_EMBEDDED_WORKER=true
KALKAN_WORKER_CONCURRENCY=2
KALKAN_SCHEDULER_INTERVAL=60
# Ownership is re-checked before scanning when the last proof is older than this.
KALKAN_REVERIFY_AFTER_DAYS=30

# E-mail: "console" prints messages to the log, "smtp" sends them.
KALKAN_MAIL_BACKEND=console
KALKAN_MAIL_FROM=Kalkan <no-reply@example.com>
KALKAN_SMTP_HOST=smtp.example.com
KALKAN_SMTP_PORT=587
KALKAN_SMTP_STARTTLS=true
KALKAN_SMTP_SSL=false
KALKAN_SMTP_USERNAME=
KALKAN_SMTP_PASSWORD=
# Users must confirm their e-mail address before they can start scans.
KALKAN_REQUIRE_EMAIL_VERIFICATION=true

# Abuse limits
KALKAN_SCANS_PER_DOMAIN_PER_DAY=5
KALKAN_MAX_DOMAINS_PER_USER=10
KALKAN_LOGIN_ATTEMPTS_PER_15_MIN=10
KALKAN_API_REQUESTS_PER_MINUTE=60
KALKAN_MAX_API_TOKENS_PER_USER=5

# Observability
KALKAN_LOG_FORMAT=text          # or json
KALKAN_LOG_LEVEL=INFO
# /metrics is served only when this is set (Authorization: Bearer <token>).
KALKAN_METRICS_TOKEN=
# `kalkan worker` serves its own metrics on this port when non-zero.
KALKAN_WORKER_METRICS_PORT=0

# Docker Compose only
POSTGRES_PASSWORD=change-me

# DEVELOPMENT ONLY - never enable on a public deployment:
# KALKAN_SKIP_VERIFICATION=true     # scan domains without proving ownership
# KALKAN_ALLOW_PRIVATE_TARGETS=true # allow scanning 127.0.0.1 / private networks
